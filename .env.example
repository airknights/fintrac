# ── Google OAuth ──────────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com → create a project
# 2. APIs & Services → Enable "Google Sheets API" and "Google Drive API"
# 3. APIs & Services → Credentials → Create → OAuth 2.0 Client ID
#    Application type: Web application
#    Authorised JavaScript origins: http://localhost:5173 (dev) + your prod URL
# 4. Copy the Client ID (no secret needed for browser apps)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# ── Cloudflare Worker (Plaid proxy) ───────────────────────────────────────────
# Your deployed worker URL — see cloudflare-worker/README.md for setup steps
# Leave blank to disable live bank sync (CSV import still works without this)
VITE_CF_WORKER_URL=https://fintrac-plaid.your-subdomain.workers.dev
